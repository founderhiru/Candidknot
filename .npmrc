# Mobile (Phase mobile-M1): @better-auth/expo pins zod ^4.5.4 as a direct
# dependency, while this app pins zod 3.25.76 for its own Zod contracts
# (route validation, forms, etc.). That makes a transitive peer of
# better-auth's dependency tree (better-call, pulled in by @better-auth/core)
# request zod ^4 at the same time the app requests zod 3, which npm's default
# (strict) peer resolution refuses to install without this flag. It does NOT
# change which zod version the app's own code resolves to (still 3.25.76) —
# it only allows @better-auth/expo's separate, nested zod copy to coexist.
legacy-peer-deps=true
