# CanidKnot — environment variables
#
# Copy this file to .env.local for local development. Real values are never
# committed; Render injects production values as real process env vars.
#
# `npm run dev` / `npm run build` validate DATABASE_URL and NEXT_PUBLIC_APP_URL
# via src/lib/env.ts. Prefix a command with SKIP_ENV_VALIDATION=1 to bypass
# validation on a local clone with no database provisioned yet.

# --- Required today ---------------------------------------------------------

# Postgres connection string. On Render this is auto-populated by linking the
# web service to a Render Postgres instance (see render.yaml).
DATABASE_URL="postgresql://user:password@localhost:5432/canidknot?schema=public"

# Public origin of the deployed app. Used for SEO metadata (canonical URLs,
# sitemap, robots, manifest), as the default same-origin API base, and as the
# OAuth baseURL for Google sign-in callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (Phase 2) — required in production ---------------------------------
#
# Three passwordless sign-in methods: Google, Mobile (SMS OTP), Email (magic
# link). All via better-auth (@/lib/auth) — no custom OTP/session/JWT code.

# Signs/verifies better-auth session cookies. Generate with:
#   openssl rand -base64 32
# Never reuse across environments (dev/staging/prod each need their own).
SESSION_SECRET=""

# Google OAuth ("Continue with Google"). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application).
# Authorized redirect URI MUST be exactly:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google in dev, and the real
# Render URL (or canidknot.com once it exists) in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend ("Continue with Email" magic link). In sandbox mode (no verified
# sending domain yet) Resend only delivers to the Resend account owner's own
# verified address — every other recipient is accepted but not delivered.
# Get a key at https://resend.com/api-keys. Swap EMAIL_FROM to a verified
# address once CanidKnot has a domain; no code change needed (@/lib/email).
RESEND_API_KEY=""
EMAIL_FROM="CanidKnot <onboarding@resend.dev>"

# SMS ("Continue with Mobile" OTP). No vendor is chosen/wired yet — see
# @/lib/sms for the provider abstraction. Leave unset (or "console") for
# local dev, which logs OTP codes to the server console instead of sending
# real SMS. Phone sign-in will refuse to run in production until this is
# set to a real, implemented provider.
# SMS_PROVIDER=""

# Only needed if the API is served from a different origin than the web app
# (not the case today — same-origin `/api` is used by default).
# NEXT_PUBLIC_API_URL=""

# Set to "true" only on the real production deploy to allow indexing
# (robots.txt / sitemap.xml / llms.txt). Any other value (or unset) is
# fail-closed (disallow-all / 404), which is correct for previews and local dev.
# SEO_INDEXABLE="true"

# --- Object storage (Phase 4) — required in production -----------------------
#
# Cloudflare R2, accessed via the S3-compatible API (@aws-sdk/client-s3).
# Stores dog photos and health passport documents — see @/lib/storage.

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public hostname files are served from (a custom domain on the bucket, or
# R2's own public dev URL hostname) — no scheme, no trailing slash.
R2_PUBLIC_HOSTNAME=""
# Must include R2_PUBLIC_HOSTNAME (comma-separated if there are others) so
# next/image is allowed to load uploaded photos. See next.config.ts.
IMAGE_REMOTE_HOSTS=""

# --- Mobile auth bridge (Phase mobile-M1) -----------------------------------
#
# The Expo app's custom URL scheme (must match app.json's "scheme" in
# /mobile). Added to better-auth's trustedOrigins so requests and OAuth
# redirects coming from the app are accepted. Defaults to "canidknot://" if
# unset — only override if the app's scheme changes.
# MOBILE_APP_SCHEME="canidknot://"

# --- Reserved for upcoming phases (not yet read by any code) ---------------
# Uncomment and wire these up when the corresponding phase lands. Listed here
# now so the shape of the eventual production environment is visible early.

# Push (Phase 14)
# PUSH_PROVIDER_API_KEY=""
