# CanidKnot — environment variables
#
# Copy this file to .env.local for local development. Real values are never
# committed; Render injects production values as real process env vars.
#
# `npm run dev` / `npm run build` validate DATABASE_URL and NEXT_PUBLIC_APP_URL
# via src/lib/env.ts. Prefix a command with SKIP_ENV_VALIDATION=1 to bypass
# validation on a local clone with no database provisioned yet.

# --- Required today ---------------------------------------------------------

# Postgres connection string. On Render this is auto-populated by linking the
# web service to a Render Postgres instance (see render.yaml).
DATABASE_URL="postgresql://user:password@localhost:5432/canidknot?schema=public"

# Public origin of the deployed app. Used for SEO metadata (canonical URLs,
# sitemap, robots, manifest) and as the default same-origin API base.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only needed if the API is served from a different origin than the web app
# (not the case today — same-origin `/api` is used by default).
# NEXT_PUBLIC_API_URL=""

# Set to "true" only on the real production deploy to allow indexing
# (robots.txt / sitemap.xml / llms.txt). Any other value (or unset) is
# fail-closed (disallow-all / 404), which is correct for previews and local dev.
# SEO_INDEXABLE="true"

# --- Reserved for upcoming phases (not yet read by any code) ---------------
# Uncomment and wire these up when the corresponding phase lands. Listed here
# now so the shape of the eventual production environment is visible early.

# Cloudflare R2 (Phase 5 — pet photos / private documents)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_HOSTNAME=""          # public read hostname, feeds IMAGE_REMOTE_HOSTS below
# IMAGE_REMOTE_HOSTS=""          # comma-separated hostnames Next/Image is allowed to load from

# Auth / OTP (Phase 2)
# SESSION_SECRET=""
# OTP_PROVIDER_API_KEY=""

# Email / push (Phase 14)
# EMAIL_PROVIDER_API_KEY=""
# PUSH_PROVIDER_API_KEY=""
