# CanidKnot mobile — environment variables
# Copy to .env.local for local development. Expo only exposes vars prefixed
# EXPO_PUBLIC_ to app code (everything else stays server-side/build-only,
# per Expo's own convention — mirrors NEXT_PUBLIC_ in the web app).

# Base URL of the CanidKnot Next.js backend this app talks to.
# Local dev against the web app running on your machine (simulator/emulator
# only — a real phone cannot reach your computer's "localhost"):
EXPO_PUBLIC_API_URL="http://localhost:3000"
# Real devices / TestFlight / Play builds MUST use the deployed backend's public
# https origin. eas.json does not set it, so provide it as an EAS variable:
#   eas env:create --name EXPO_PUBLIC_API_URL --value https://<your-backend> \
#     --environment production --environment preview --visibility plaintext
# It must be the SAME origin as NEXT_PUBLIC_APP_URL on the backend (magic links
# are issued on that host).

# Must exactly match app.json's "scheme" AND the web app's MOBILE_APP_SCHEME
# env var (see /.env.example at the repo root) — this is the same value on
# both sides of the trust relationship set up in src/lib/auth.ts.
EXPO_PUBLIC_APP_SCHEME="canidknot"
