{
  "expo": {
    "name": "CanidKnot",
    "slug": "canidknot",
    "scheme": "canidknot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.canidknot.app"
    },
    "android": {
      "package": "com.canidknot.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F3"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CanidKnot needs access to your photos so you can add pictures of your dog.",
          "cameraPermission": "CanidKnot needs access to your camera so you can take a photo of your dog."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d82bc94b-0eb5-4bc5-b02e-efc18daa6642"
      }
    },
    "owner": "rontest"
  }
}
